# Normalise line endings. Without this, a Windows checkout commits CRLF, a CI
# runner on Linux commits LF, and the two produce whole-file diffs in which
# nothing actually changed.
* text=auto eol=lf

# Sources -- always LF in the repository.
*.c      text eol=lf
*.h      text eol=lf
*.ino    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.txt    text eol=lf
*.yml    text eol=lf

# The plot is an export with text rendered as paths: a one-line diff is
# meaningless, so keep it out of diff output and out of language statistics.
*.svg    text eol=lf -diff
results/*.svg linguist-generated=true
